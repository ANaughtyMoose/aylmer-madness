 "entries": [
  {
   "who": "Vendeur",
   "kind": "walkon",
   "file": "assets/text/calls.json",
   "line": 6,
   "owner": "E-06",
   "why": "walkon in English",
   "text": "You leave your name and number and ask whether the Firebird behind the garage on Chemin Pink is still there."
  },
  {
   "who": "Vendeur",
   "kind": "walkon",
   "file": "assets/text/calls.json",
   "line": 12,
   "owner": "E-06",
   "why": "walkon in English",
   "text": "Hello? Yeah, calling about the Golf GTI? Are you on the Quebec side?"
  },
  {
   "who": "Vendeur",
   "kind": "walkon",
   "file": "assets/text/calls.json",
   "line": 12,
   "owner": "E-06",
   "why": "walkon in English",
   "text": "You'll need an out-of-province inspection to register it in Quebec, but mechanically it's mint. Timing belt done last spring."
  },
  {
   "who": "Vendeur",
   "kind": "walkon",
   "file": "assets/text/calls.json",
   "line": 20,
   "owner": "E-06",
   "why": "walkon in English",
   "text": "You state your interest in the four fifteen-inch wheels listed in the classifieds."
  },
  {
   "who": "Vendeur",
   "kind": "walkon",
   "file": "assets/text/calls.json",
   "line": 26,
   "owner": "E-06",
   "why": "walkon in English",
   "text": "Yes, hello. Just so we're clear, this is the genuine Si trim with the factory sunroof, not a base car with badges."
  },
  {
   "who": "Vendeur",
   "kind": "walkon",
   "file": "assets/text/calls.json",
   "line": 26,
   "owner": "E-06",
   "why": "walkon in English",
   "text": "I have the original window sticker, the factory cassette head unit in bubble wrap, and both service manuals."
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 247,
   "owner": "E-06",
   "why": "main cast in franglais",
   "text": "« Mon Sunfire a encore pété son alternateur hier. Fait qu’on prend ton truck. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 252,
   "owner": "E-06",
   "why": "main cast in French",
   "text": "« Pèse su’l gaz. Plus vite c’est fini, plus vite j’peux aller rien faire chez nous. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 257,
   "owner": "E-06",
   "why": "main cast in franglais",
   "text": "« Touche pas au poste de radio. Le silence me dérange moins que tes goûts musicaux. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 262,
   "owner": "E-06",
   "why": "main cast in French",
   "text": "« Si la transmission lâche, j’pousse pas. J’ai mal au dos. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 267,
   "owner": "E-06",
   "why": "main cast in French",
   "text": "« Y fait trente degrés, ton air climatisé pousse du vent tiède. Formidable. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 272,
   "owner": "E-06",
   "why": "main cast in French",
   "text": "« Le chemin Pink est plein de trous. Essaie d’en éviter au moins un sur deux. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 277,
   "owner": "E-06",
   "why": "main cast in French",
   "text": "« Si quelqu’un demande, j’suis à Mayo. J’suis toujours à Mayo. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 282,
   "owner": "E-06",
   "why": "main cast in franglais",
   "text": "« On part. Essaie de pas faire caler le moteur aux lumières comme la semaine passée. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 287,
   "owner": "E-06",
   "why": "main cast in French",
   "text": "« J’ai un sac de chips sel et vinaigre sous le banc. Mange-les pas, c’est mon dîner. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 292,
   "owner": "E-06",
   "why": "main cast in franglais",
   "text": "« Si on se fait pogner par les flics, c’est toé qui as le volant, j’te connais pas. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 297,
   "owner": "E-06",
   "why": "main cast in French",
   "text": "« Encore une ride d’Aylmer... La ville où y se passe jamais rien à part la rouille qui pousse. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 302,
   "owner": "E-06",
   "why": "main cast in French",
   "text": "« Envoye, décolle. J’ai deux heures à perdre avant de retourner à Mayo. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 307,
   "owner": "E-06",
   "why": "main cast in franglais",
   "text": "« C’est fini. Mon dos a survécu à ta suspension en bois d’arbre. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 312,
   "owner": "E-06",
   "why": "main cast in franglais",
   "text": "« On est vivants. C’est déjà plus que ce à quoi je m’attendais en partant. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 317,
   "owner": "E-06",
   "why": "main cast in French",
   "text": "« Parke ça croche de même, de toute façon personne vient jamais dans ce coin-là. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 322,
   "owner": "E-06",
   "why": "main cast in French",
   "text": "« Bon. J’m’en va m’coucher devant Télétoon en buvant du Tang. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 327,
   "owner": "E-06",
   "why": "main cast in French",
   "text": "« T’as manqué le poteau d’un pied. Beau travail d’improvisation. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 332,
   "owner": "E-06",
   "why": "main cast in French",
   "text": "« J’ai plus de sensation dans ma jambe droite, mais la livraison est faite. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 337,
   "owner": "E-06",
   "why": "main cast in franglais",
   "text": "« Débarque-moé là. Le soleil me tape su’a tête pis ton banc sent le chien mouillé. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 342,
   "owner": "E-06",
   "why": "main cast in franglais",
   "text": "« Au moins le moteur a pas explosé. Pas encore. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 347,
   "owner": "E-06",
   "why": "main cast in French",
   "text": "« Voilà. Une autre journée passionnante qui s’achève dans le grand Aylmer. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 352,
   "owner": "E-06",
   "why": "main cast in French",
   "text": "« J’ai laissé un emballage de Jos Louis dans ta porte. Tu remercieras la visite. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 357,
   "owner": "E-06",
   "why": "main cast in franglais",
   "text": "« On a fini. Whatever. M’a aller voir si mon Sunfire veut démarrer. »"
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/dialogue.json",
   "line": 362,
   "owner": "E-06",
   "why": "main cast in franglais",
   "text": "« Pas pire. On a évité la police pis la scrap pour aujourd’hui. »"
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 19,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Heille! Coupe le moteur, ma mère dort à dix heures."
  },
  {
   "who": "Sayyad",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 21,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "ENFIN. Ça fait vingt minutes qu'on parle de rien."
  },
  {
   "who": "Sayyad",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 22,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Le nouveau PowerBook, le clavier s'allume. It LIGHTS UP."
  },
  {
   "who": "Abraham",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 23,
   "owner": "E-07",
   "why": "main cast in franglais",
   "text": "Assis-toi. Y a de la place sur les marches."
  },
  {
   "who": "Abraham",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 24,
   "owner": "E-07",
   "why": "main cast in franglais",
   "text": "Salut, man. J'ai amené ma guitare. Personne a demandé."
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 25,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "...t'es en retard."
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 26,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Ouais."
  },
  {
   "who": "Zahra",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 27,
   "owner": "E-07",
   "why": "main cast in franglais",
   "text": "Sayyad a dit que t'avais pas ton permis pour vrai. Je le crois pas, mais il l'a dit."
  },
  {
   "who": "Zahra",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 28,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Je rentre à dix heures. Pas parce que je veux."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 32,
   "owner": "E-07",
   "why": "main cast in franglais",
   "text": "...faque le gars me dit que le moteur est correct. Correct! Écoute. Écoute-moi deux secondes."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 33,
   "owner": "E-07",
   "why": "main cast in franglais",
   "text": "Y a une manière de reculer dans l'entrée sans toucher au bac. Une seule. Je vais te la montrer avec mes mains."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 34,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Regarde-le. REGARDE-LE. Trois semaines qu'y est là-haut. Ça, c'est de l'ingénierie."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 35,
   "owner": "E-07",
   "why": "main cast in franglais",
   "text": "Ma mère l'a vu hier. A l'a rien dit. Rien! C'est ça le plus beau de l'affaire."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 36,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Le monde ralentit devant chez nous pour le voir. Le monde. Ralentit. Pour NOUS."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 37,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "J'ai un plan pour le divan. Un vrai plan. Faut juste que t'amènes ton truck."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 39,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "T'as battu sa Civic?! Attends. Attends attends attends. Recommence par le début."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 40,
   "owner": "E-07",
   "why": "main cast in franglais",
   "text": "Un canot. Au Bondo. Jusqu'à l'île. Je l'ai conté à trois personnes pis y a personne qui me croit."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 41,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "T'es venu en BUS. Un bus d'école. Dans MON entrée. Non mais."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 42,
   "owner": "E-07",
   "why": "main cast in franglais",
   "text": "C'est... c'est un cart de golf. Ok. OK! Non mais ok. Explique."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 43,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Qu'est-ce qui est arrivé au char?! Non — dis-moi pas. Dis-moi. Dis-moi tout."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 44,
   "owner": "E-07",
   "why": "main cast in franglais",
   "text": "T'as faite plus d'affaires cet été que moi dans toute ma vie, pis j'ai un an de plus que toi."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 45,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Non non non, écoute. Écoute-moi. Norm Lafleur va te charger le double si t'attends. Le DOUBLE. Regarde ma main."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 46,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "...pis c'est là que Zahra m'a dit que j'avais tort. Elle avait raison. Mais écoute pareil."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 47,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Attends attends attends. Les deux, là. Écoutez-moi les deux en même temps. C'est important."
  },
  {
   "who": "Mike",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 48,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Le Tour des Maringouins, c'est pas une course, c'est un test de nerfs. Je te le dis avec mes mains: c'est ÇA le virage."
  },
  {
   "who": "Sayyad",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 50,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "C'est quoi ça? Non. Non non non. Ôte-moi ça pis mets mon CD."
  },
  {
   "who": "Adam",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 50,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Non."
  },
  {
   "who": "Sayyad",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 51,
   "owner": "E-07",
   "why": "main cast in franglais",
   "text": "Y a pas de musique. Why is there no music? Pars le radio, man."
  },
  {
   "who": "Sayyad",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 52,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "J'ai gravé une compile hier soir. Blink, 50 Cent, pis une toune de Jean Leloup pour ma mère."
  },
  {
   "who": "Sayyad",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 53,
   "owner": "E-07",
   "why": "main cast in franglais",
   "text": "Ma Civic te mangerait tout rond. On se le dit une fois pis on l'oublie."
  },
  {
   "who": "Sayyad",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 54,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "J'ai laissé faire, c'te soir-là. C'tait pour te faire plaisir. Demande à Adam."
  },
  {
   "who": "Sayyad",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 55,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Trois doughnuts devant chez nous pis j'ai rien entendu. Ma mère, elle, en parle encore."
  },
  {
   "who": "Sayyad",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 56,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Le divan, c'tait mon idée. Mike va dire que c'tait la sienne. C'tait mon idée."
  },
  {
   "who": "Sayyad",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 57,
   "owner": "E-07",
   "why": "main cast in franglais",
   "text": "T'es venu avec MA Civic. ...continue. Ça me dérange pas. Continue de parler."
  },
  {
   "who": "Sayyad",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 58,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "T'es cassé, hein? Ça paraît dans ta face, mon homme."
  },
  {
   "who": "Sayyad",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 59,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Où t'as pris c't'argent-là? Non. Laisse faire. J'veux pas le savoir."
  },
  {
   "who": "Sayyad",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 60,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Six checkpoints en soixante secondes. La ville t'appartient. Officiellement."
  },
  {
   "who": "Sayyad",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 61,
   "owner": "E-07",
   "why": "main cast in franglais",
   "text": "Trois courses. Y a plus personne dans Aylmer qui veut se mesurer à toi. Ça inclut moi."
  },
  {
   "who": "Abraham",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 63,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Assis-toi deux minutes. Ça changera rien que tu partes à dix heures ou à dix heures et quart."
  },
  {
   "who": "Abraham",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 64,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Y font le même party à Deschênes chaque vendredi pis y pensent qu'on le sait pas."
  },
  {
   "who": "Abraham",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 65,
   "owner": "E-07",
   "why": "main cast in franglais",
   "text": "Ton truck, man. What happened to ton truck?"
  },
  {
   "who": "Abraham",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 66,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Des nachos à cinq heures du matin. J'en reprendrais."
  },
  {
   "who": "Abraham",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 67,
   "owner": "E-07",
   "why": "main cast in French",
   "text": "Tu travailles pas mal pour un été. Y en aura pas d'autre comme celui-là, tu sais."
  },
  {
   "who": "Abraham",
   "kind": "main",
   "file": "assets/text/hangout.json",
   "line": 68,
   "owner": "E-07",
   "why": "main cast in franglais",
