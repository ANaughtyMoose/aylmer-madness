.DS_Store
public/
dist/
data/raw/
__pycache__/

# The player's own mixtape (see assets/radio/README.md) — never ours to commit.
assets/radio/*
!assets/radio/README.md
!assets/radio/playlist.example.json
!assets/radio/playlist.json

# Raw Street View crops pulled by the look pass are Google's pixels: reference only, never shipped.
gemini-inbox/look/streetview/

# Gemini's raw asset downloads (333 MB of CC0 packs) are reference for tools/gltf2mesh.mjs; only converted meshes ship.
gemini-inbox/assets/src/

# Borrowed model SOURCES (Kenney / Quaternius / Poly Haven .glb + .gltf). The
# CONVERTED assets/models/*.json are committed and are what the game loads;
# the originals are a build input, re-downloadable from the URLs in
# assets/models/LICENSES.md, and there is no reason to carry them in git.
assets/models/src/

# Gemini's cinematic pass put Thomas's own photograph and his real Québec plate
# into gemini-inbox/. The repo is public. These never ship, whatever else in
# gemini-inbox/ is ever committed.
gemini-inbox/look/ui/tom_*
gemini-inbox/look/ui/title_key_art.png
gemini-inbox/look/cars/ranger/plate_*
gemini-inbox/**/media_*
gemini-inbox/cinema/
gemini-inbox/look/cars/
gemini-inbox/look/ui/
gemini-inbox/showcase.html
out/

spike-log.txt
data/raw/

# Photographs of real people, for the story pass (docs/ART-PHOTO-BRIEF.md). The
# repo is public; these are Tom's family and friends and they never ship.
references/story/*
!references/story/README.md

# Gemini's working directories. The tracked reports in gemini-inbox/*.md are the
# output; everything below is 1.7 GB of raw input, renders and scratch that is
# re-generatable and has no business in git history.
gemini-inbox/look/
gemini-inbox/assets/
gemini-inbox/redo/
gemini-inbox/interiors/
gemini-inbox/build_kernel/
gemini-inbox/build_workdir/
gemini-inbox/video_pipeline/
gemini-inbox/voiceover_clips/
gemini-inbox/*.mp4

# Scratch copies of the calendar data at the repo root. The real files are the
# ones the game loads from assets/text/.
/palette2004.json
/summer2004.json
/data/palette2004.json
/data/summer2004.json
